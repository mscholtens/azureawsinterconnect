# =============================================================================
# credentials.env
#
# This file is TRACKED IN GIT (intentionally not gitignored), same pattern
# used in the sibling aws-gcp-interconnect-experiment project.
#
# Workflow:
#   1. Before running any script, replace every REPLACE_ME value with your
#      real credentials/config.
#   2. Run the experiment.
#   3. Before committing/pushing this repo anywhere, reset every value in
#      this file back to REPLACE_ME.
#
# Unlike the GCP project, Azure auth doesn't need a separate downloadable
# credential file — a Service Principal's credentials are just a handful
# of flat strings (subscription/tenant/client ID + client secret), so
# they live directly here alongside the AWS credentials.
# =============================================================================

# --- AWS ---
AWS_ACCESS_KEY_ID=#REPLACE_ME
AWS_SECRET_ACCESS_KEY=#REPLACE_ME
# CONFIRMED: US East (N. Virginia) is one of AWS's four regions supported
# for the Azure pairing (alongside Frankfurt, N. California, Sydney).
AWS_REGION=us-east-1 #REPLACE_ME
AWS_ACCOUNT_ID=#REPLACE_ME

# --- Azure ---
# Service Principal credentials — create with:
#   az ad sp create-for-rbac --name interconnect-experiment --role Contributor --scopes /subscriptions/<AZURE_SUBSCRIPTION_ID>
AZURE_SUBSCRIPTION_ID=#REPLACE_ME
AZURE_TENANT_ID=#REPLACE_ME
AZURE_CLIENT_ID=#REPLACE_ME
AZURE_CLIENT_SECRET=#REPLACE_ME

## CONFIRMED: germanywestcentral is Azure's Frankfurt region, and is
# directly confirmed (via a German tech outlet reporting on the launch)
# as the intended Azure-side pairing for AWS eu-central-1 (Frankfurt).
# SWITCHED from germanywestcentral to eastus. Germany West Central
# proved unusable for this experiment: every VM family with NON-ZERO
# subscription quota failed on live capacity (SkuNotAvailable —
# B1s, B2s, D2s_v3, D2s_v4, A2_v2, F2s_v2, plus a Spot attempt), while
# every family that WAS regionally available (D2as_v5, D2_v5,
# B2als_v2) had ZERO subscription quota (0/0). Two separate gates, and
# no size found with both open. eastus is paired with AWS us-east-1 and
# typically has much deeper capacity.
AZURE_REGION=eastus
 
# ExpressRoute peering location for the MultiCloud circuit. NOT the same
# thing as AZURE_REGION — this is a physical/metro peering point name.
#
# CONFIRMED via `az network express-route list-service-providers`,
# filtered for AWS: valid peeringLocations are exactly
# [australiaeast, germanywc, useast, useast2euap, uswest] — a bespoke
# abbreviated scheme, not classic ExpressRoute city names and not even
# consistently matching Azure's own region codes (useast/uswest are
# reversed from Azure's actual eastus/westus). germanywc is the
# Frankfurt/Germany West Central entry.
AZURE_PEERING_LOCATION=useast
 
# --- SSH ---
SSH_KEY_NAME_AWS=ec2-key
SSH_KEY_NAME_AZURE=azure-vm-key
 
# --- Networking ---
AWS_VPC_CIDR=10.0.0.0/16
AWS_SUBNET_CIDR=10.0.1.0/24
AZURE_VNET_CIDR=10.2.0.0/16
AZURE_SUBNET_CIDR=10.2.1.0/24
# Azure requires a dedicated subnet literally named "GatewaySubnet" for
# the ExpressRoute Gateway — this CIDR is for that subnet, not the VM.
AZURE_GATEWAY_SUBNET_CIDR=10.2.255.0/27
 
# --- Instance sizing ---
AWS_INSTANCE_TYPE=t3.micro
AZURE_VM_SIZE=Standard_D2s_v4
 
# --- ExpressRoute / Interconnect ---
# 1 Gbps is the preview cap on both sides (AWS Interconnect - multicloud
# and Azure Multicloud Interconnect).
AZURE_CIRCUIT_BANDWIDTH_MBPS=1000