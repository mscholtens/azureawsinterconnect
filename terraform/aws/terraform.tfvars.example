# Copy to terraform.tfvars for manual/debugging runs outside the
# scripts. terraform.tfvars is gitignored; this .example is committed.
#
# scripts/02-aws-up.sh does NOT use this file — it exports TF_VAR_*
# directly, which takes precedence over any terraform.tfvars present.

aws_region           = "us-east-1"
ssh_public_key_path  = "../../keys/ec2-key.pub"
activation_key       = "REPLACE_WITH_REAL_ACTIVATION_KEY_FROM_AZURE"

# --- optional overrides (defaults shown) ---
# vpc_cidr         = "10.0.0.0/16"
# subnet_cidr      = "10.0.1.0/24"
# instance_type    = "t3.micro"
# peer_cidr        = "10.2.0.0/16"  # Azure side's VNet CIDR
# allowed_ssh_cidr = "0.0.0.0/0"
